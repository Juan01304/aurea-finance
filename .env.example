# PostgreSQL (optional; when set, replaces SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/database

# E-mail: Resend (recommended for deploy)
# RESEND_API_KEY=re_...
# RESEND_FROM=Aurea Finance <acesso@seudominio.com>

# E-mail: SMTP alternative
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=senha-de-app
# SMTP_FROM=Aurea Finance <seu-email@gmail.com>

# OpenAI (optional; local assistant remains available without it)
# OPENAI_API_KEY=...
OPENAI_MODEL=gpt-5.6-luna
